<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RoslynToolsPath>$(MSBuildSDKsPath)/../DotnetTools/dotnet-format</RoslynToolsPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(RoslynToolsPath)/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(RoslynToolsPath)/Microsoft.CodeAnalysis.CSharp.dll" />
    <Reference Include="Microsoft.CodeAnalysis.Workspaces" HintPath="$(RoslynToolsPath)/Microsoft.CodeAnalysis.Workspaces.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" HintPath="$(RoslynToolsPath)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll" />
  </ItemGroup>
</Project>
