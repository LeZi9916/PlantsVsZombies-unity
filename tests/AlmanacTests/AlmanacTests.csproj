    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <UnityManaged Condition="'$(UnityManaged)' == ''">C:/Program Files/Unity Editors/6000.3.17f1/Editor/Data/Managed/UnityEngine</UnityManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs.txt" />
