<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net9.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' == 'net9.0'">Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Profiles/UserProfile.cs" Link="UserProfile.cs" />
    <Compile Include="../../Assets/Scripts/Profiles/ProfileCatalog.cs" Link="ProfileCatalog.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
