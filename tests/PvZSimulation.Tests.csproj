<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../Assets/Scripts/GameSimulation.cs" Link="GameSimulation.cs" />
    <Compile Include="../Assets/Scripts/Plants/*.cs" Link="Plants/%(Filename)%(Extension)" />
    <Compile Include="../Assets/Scripts/Timing/*.cs" Link="Timing/%(Filename)%(Extension)" />
    <Compile Include="../Assets/Scripts/VerifiedData/VerifiedDataCatalog.cs" Link="VerifiedDataCatalog.cs" />
    <Compile Include="../Assets/Scripts/VerifiedData/VerifiedData.generated.cs" Link="VerifiedData.generated.cs" />
  </ItemGroup>
<ItemGroup><Compile Include="../Assets/Scripts/Random/*.cs" /></ItemGroup>
</Project>
